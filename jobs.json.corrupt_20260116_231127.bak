  "6a18471a-ed59-44e3-87a6-50e49afb5a86": {
    "id": "6a18471a-ed59-44e3-87a6-50e49afb5a86",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T15:03:38.858347",
