  "505442d8-3d93-49ee-8bec-60a86893bf2a": {
    "id": "505442d8-3d93-49ee-8bec-60a86893bf2a",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T13:47:57.192301",
