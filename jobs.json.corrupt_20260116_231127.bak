  "1116b7bb-e661-4e06-b1a1-781d10ece393": {
    "id": "1116b7bb-e661-4e06-b1a1-781d10ece393",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T14:37:15.896508",
    "updated_at": "2026-01-05T08:53:28.770835",
