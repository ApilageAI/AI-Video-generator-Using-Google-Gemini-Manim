  "9baf93f3-ea2c-4537-83ec-1c66b9afe5e7": {
    "id": "9baf93f3-ea2c-4537-83ec-1c66b9afe5e7",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2025-12-31T20:39:16.478134",
