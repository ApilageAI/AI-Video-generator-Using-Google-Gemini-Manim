  "cab670a9-17f3-4355-bd3c-43e546f04212": {
    "id": "cab670a9-17f3-4355-bd3c-43e546f04212",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T14:43:58.017754",
