  "a0814bda-e5bb-4d24-ace3-f87619c88721": {
    "id": "a0814bda-e5bb-4d24-ace3-f87619c88721",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2025-12-31T16:13:38.085614",
    "updated_at": "2025-12-31T18:18:27.710338",
