  "83faf91d-deea-4617-962d-7302ab6d1ebc": {
    "id": "83faf91d-deea-4617-962d-7302ab6d1ebc",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T15:06:39.649109",
