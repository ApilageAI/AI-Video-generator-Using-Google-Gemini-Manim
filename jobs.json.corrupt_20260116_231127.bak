  "7855dd8c-1718-4512-a381-4421f03d7b33": {
    "id": "7855dd8c-1718-4512-a381-4421f03d7b33",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2025-12-31T20:42:04.136187",
    "updated_at": "2026-01-01T18:32:15.686181",
