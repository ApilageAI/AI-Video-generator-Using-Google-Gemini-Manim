  "3a2b3db6-4156-410f-b055-4e3d6fe2bb8a": {
    "id": "3a2b3db6-4156-410f-b055-4e3d6fe2bb8a",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T14:08:19.519889",
