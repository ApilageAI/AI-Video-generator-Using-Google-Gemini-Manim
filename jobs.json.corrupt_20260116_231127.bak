  "1e3f83df-fe42-4b0f-b16c-28274bf8fa04": {
    "id": "1e3f83df-fe42-4b0f-b16c-28274bf8fa04",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T14:37:37.687381",
    "updated_at": "2026-01-05T09:23:52.914938",
