  "b39c6548-2507-485c-8afb-b894b1a621e6": {
    "id": "b39c6548-2507-485c-8afb-b894b1a621e6",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2025-12-31T16:14:03.860608",
    "updated_at": "2025-12-31T19:08:52.950011",
