  "809a24a5-9d9e-4f78-800d-2dead095da1a": {
    "id": "809a24a5-9d9e-4f78-800d-2dead095da1a",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T14:12:35.967627",
