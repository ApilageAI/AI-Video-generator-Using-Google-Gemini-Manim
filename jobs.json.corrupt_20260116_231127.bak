  "4168821d-f1fe-4083-8780-1523442053bf": {
    "id": "4168821d-f1fe-4083-8780-1523442053bf",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T13:45:43.531800",
