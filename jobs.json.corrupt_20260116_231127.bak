  "3a0504eb-3a49-4f3c-9788-d7bb12aa18c5": {
    "id": "3a0504eb-3a49-4f3c-9788-d7bb12aa18c5",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T13:47:26.098882",
