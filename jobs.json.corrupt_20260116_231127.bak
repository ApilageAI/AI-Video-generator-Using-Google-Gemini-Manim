  "b29eb02e-7375-46ba-9edb-6720d55695c5": {
    "id": "b29eb02e-7375-46ba-9edb-6720d55695c5",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T14:56:41.659913",
    "updated_at": "2026-01-06T09:47:00.299941",
    "video_url": "/uploads/MathExplanationScene_20260106_094700.mp4",
    "error": null,
    "progress": "Completed!",
    "video_filename": "MathExplanationScene_20260106_094700.mp4",
    "subtitles": "```webvtt\nWEBVTT\n\n00:00.000 --> 00:05.800\nHey everyone, and welcome! Today we're going to learn about what a test is.\n\n00:05.800 --> 00:15.800\nSimply put, a test is a way to find out something. It's a process or procedure designed to measure or evaluate a specific thing.\n\n00:15.800 --> 00:26.700\nThink about it like this: a spelling test checks how well you know your spelling words. Or, a taste test helps decide which cookie tastes the best.\n\n00:26.700 --> 00:37.500\nTests aren't just for school or food, though. Doctors use tests to check your health, and engineers use tests to see if a bridge is strong enough.\n\n00:37.500 --> 00:48.100\nSo, a test is just a way to gather information and make a decision based on that information.\n\n00:48.100 --> 00:52.000\nIt helps us learn and understand the world around us better. This video was created by Apilage AI.\n```"
  },
  "f46bebcd-216d-4965-97c6-5854c18cd2f1": {
    "id": "f46bebcd-216d-4965-97c6-5854c18cd2f1",
    "topic": "Test",
