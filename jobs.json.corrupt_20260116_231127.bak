  "184c1f80-7ee7-42e3-a20f-7d7e8834cccb": {
    "id": "184c1f80-7ee7-42e3-a20f-7d7e8834cccb",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T14:39:18.591459",
