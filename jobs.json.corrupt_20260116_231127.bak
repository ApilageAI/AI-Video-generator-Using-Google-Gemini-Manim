  "adbb08e1-e28f-44a2-9e0f-aecd1ab15f40": {
    "id": "adbb08e1-e28f-44a2-9e0f-aecd1ab15f40",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2025-12-31T20:37:10.475838",
