  "17c788d3-70c4-401b-ac45-eef662ecdc2d": {
    "id": "17c788d3-70c4-401b-ac45-eef662ecdc2d",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
