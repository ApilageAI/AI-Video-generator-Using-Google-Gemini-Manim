  "254a0f1c-02a9-41db-ab27-6e63a6e5d65a": {
    "id": "254a0f1c-02a9-41db-ab27-6e63a6e5d65a",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T15:10:24.720272",
    "updated_at": "2026-01-07T02:55:51.106873",
