  "c7742c38-6c90-4e88-8c68-0fa62f173dcc": {
    "id": "c7742c38-6c90-4e88-8c68-0fa62f173dcc",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
