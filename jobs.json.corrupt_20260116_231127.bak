  "1e57280d-0edc-4588-8944-37c26d43ff97": {
    "id": "1e57280d-0edc-4588-8944-37c26d43ff97",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T14:50:25.524938",
    "updated_at": "2026-01-06T02:07:57.378170",
