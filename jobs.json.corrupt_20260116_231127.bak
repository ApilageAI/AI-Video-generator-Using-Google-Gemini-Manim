  "f25d22ee-dd25-4989-b3c5-9db6a765a572": {
    "id": "f25d22ee-dd25-4989-b3c5-9db6a765a572",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T15:07:20.068353",
