  "c3b17f1d-f89f-485b-8a65-f82e3b29ef7d": {
    "id": "c3b17f1d-f89f-485b-8a65-f82e3b29ef7d",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T15:04:24.624772",
    "updated_at": "2026-01-06T20:02:19.604181",
