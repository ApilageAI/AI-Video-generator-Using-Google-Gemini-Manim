  "cde6f524-f1ce-4cab-b380-e0dc88a5b9aa": {
    "id": "cde6f524-f1ce-4cab-b380-e0dc88a5b9aa",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T15:07:28.477741",
