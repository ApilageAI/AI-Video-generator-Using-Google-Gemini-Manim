  "31877510-6014-459e-9636-9d838206bf5e": {
    "id": "31877510-6014-459e-9636-9d838206bf5e",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T14:50:57.608043",
