  "e05a94dd-d8bb-4ed5-a38c-743dd2692a5d": {
    "id": "e05a94dd-d8bb-4ed5-a38c-743dd2692a5d",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2026-01-01T14:17:46.586889",
    "updated_at": "2026-01-04T06:53:59.761036",
