  "dbbe07c7-00c8-495a-9472-017e4c1dc30b": {
    "id": "dbbe07c7-00c8-495a-9472-017e4c1dc30b",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2025-12-31T16:16:22.829078",
