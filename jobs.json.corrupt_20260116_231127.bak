  "1e1e44db-c769-491a-8c47-1b6dcb58a4f1": {
    "id": "1e1e44db-c769-491a-8c47-1b6dcb58a4f1",
    "topic": "Test",
    "level": "basic",
    "status": "completed",
    "queue_position": 1,
    "created_at": "2025-12-31T16:13:49.374459",
    "updated_at": "2025-12-31T18:39:57.424504",
    "video_url": "/uploads/MathExplanationScene_20251231_183957.mp4",
    "error": null,
    "progress": "Completed!",
    "video_filename": "MathExplanationScene_20251231_183957.mp4",
    "subtitles": "```webvtt\nWEBVTT\n\n00:00.000 --> 00:02.000\nHey everyone, and welcome!\n\n00:02.000 --> 00:06.000\nToday we're going to talk about tests \u2013 but don't worry, it's not the kind you cram for!\n\n00:06.000 --> 00:12.000\nIn this case, a \"test\" is simply a way to check if something works the way it's supposed to.\n\n00:12.000 --> 00:17.000\nThink of it like this: You bake a cake, right? You test it by sticking a toothpick in.\n\n00:17.000 --> 00:21.000\nIf the toothpick comes out clean, the cake is done. That's a test!\n\n00:21.000 --> 00:26.000\nOr, maybe you're trying out a new lightbulb. You screw it in and flip the switch.\n\n00:26.000 --> 00:29.000\nIf the light turns on, the test is successful!\n\n00:29.000 --> 00:34.000\nSo, tests are all about checking things. Making sure they do what they're designed to do.\n\n00:34.000 --> 00:40.000\nWhether it's a cake, a lightbulb, or something else entirely.\n\n00:40.000 --> 00:44.000\nBasically, it is a way to verify your product works.\n\n00:44.000 --> 00:46.000\nThat's the basic idea behind testing!\n\n00:46.000 --> 00:48.000\nThis video was created by Apilage AI.\n```"
  },
  "4eb8c92a-c8ea-4061-83ec-cf22417c7279": {
